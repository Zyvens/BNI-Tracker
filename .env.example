# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o ".env" (já está no .gitignore).

# Connection string do Postgres. Para desenvolvimento local e produção,
# use um banco gratuito no Neon (https://neon.tech) — veja o README.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/nomedobanco?sslmode=require"

# Segredo usado para assinar os cookies de sessão (login).
# Gere um valor aleatório forte, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-este-segredo-em-producao"
