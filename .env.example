# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" nem qualquer credencial real.

# PostgreSQL / Neon
# Obtenha a connection string no Neon Console e mantenha-a somente em secrets locais/Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Segredo usado para assinar os cookies de sessão (login).
# Gere um valor aleatório forte, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Chaves VAPID para notificações push (Web Push API).
# Gere um par novo com:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://seu-dominio.vercel.app"

# Segredo para autorizar o endpoint de cron (/api/cron/notifications).
# Gere um valor aleatório forte e mantenha-o somente nos secrets do ambiente.
CRON_SECRET=""
